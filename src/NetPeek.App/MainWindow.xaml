<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPeek — Your connections, at a glance." Width="1180" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F7F9F6" Foreground="#20382E" FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <SolidColorBrush x:Key="Ink" Color="#20382E"/>
    <SolidColorBrush x:Key="Muted" Color="#5F7168"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#294F3E"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="BorderBrush" Value="#D5E1D8"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E6F1EA"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#D3E7DB"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#25664F"/><Setter TargetName="ButtonBorder" Property="Background" Value="#E6F1EA"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="7,3"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="30"/></Style>
    <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="600"/><Setter Property="Padding" Value="10"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#D5E1D8" BorderThickness="1" CornerRadius="10"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#5F7168" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center"/>
          <Border x:Name="ComboFocus" IsHitTestVisible="False" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border Background="White" BorderBrush="#D5E1D8" BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="#25664F"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#E6F1EA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/>
      <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="RowBackground" Value="#FFFFFF"/>
      <Setter Property="AlternatingRowBackground" Value="#F7F9F6"/><Setter Property="RowHeight" Value="36"/>
      <Setter Property="FrozenColumnCount" Value="3"/>
      <Setter Property="SelectionMode" Value="Single"/><Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF4EF"/><Setter Property="Foreground" Value="#52675A"/><Setter Property="Padding" Value="7,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#20382E"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDF5EF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D6EBDD"/><Setter Property="Foreground" Value="#20382E"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="7,2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#20382E"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D6EBDD"/><Setter Property="Foreground" Value="#20382E"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#25664F"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="EndpointText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
    <Style x:Key="StatusText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding StatusHint}"/></Style>
    <Style x:Key="HeaderToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" Padding="12,9" CornerRadius="13" BorderBrush="Transparent" BorderThickness="2">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center"/>
            <Path x:Name="Chevron" Grid.Column="1" Data="M 2,3 L 7,8 L 2,13" Stroke="#708276" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#F2F7F2"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#25664F"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AppExpander" TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <Border Background="White" BorderBrush="#DFE8E1" BorderThickness="1" CornerRadius="16">
          <StackPanel>
            <ToggleButton Style="{StaticResource HeaderToggle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" AutomationProperties.Name="{Binding Name}"/>
            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="12,0,12,10"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="AppHeader">
      <Grid Margin="0,0,6,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" Background="#EDF3ED" CornerRadius="11" HorizontalAlignment="Left">
          <Grid><TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold" Foreground="#537260" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#5F7168" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{Binding DisplayStatusBrush}" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,5"><TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="#355746"/></Border>
        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock Text="{Binding DisplayCountText}" FontSize="19" FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding DisplayCountLabel}" FontSize="10" Foreground="#5F7168" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="RailPanel" Background="#E6F1EA" BorderBrush="#DBE8DD" BorderThickness="0,0,1,0">
      <Grid x:Name="RailContent" Margin="16,20,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Background="#CDE5D5" Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Canvas Width="40" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="M 6,12 L 10,4 Q 13,1 17,6 M 23,6 Q 27,1 30,4 L 34,12" Stroke="#28684F" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Width="18" Height="20" Canvas.Left="2" Canvas.Top="10" Fill="#F7FCF6" Stroke="#28684F" StrokeThickness="2.5"/><Ellipse Width="18" Height="20" Canvas.Left="20" Canvas.Top="10" Fill="#F7FCF6" Stroke="#28684F" StrokeThickness="2.5"/>
              <Ellipse Width="6" Height="7" Canvas.Left="10" Canvas.Top="16" Fill="#28684F"/><Ellipse Width="6" Height="7" Canvas.Left="25" Canvas.Top="16" Fill="#28684F"/>
            </Canvas>
          </Border>
          <TextBlock Text="NetPeek" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"/>
          <TextBlock x:Name="BrandTagline" Text="Your connections,&#x0a;at a glance." Foreground="#526E5C" FontFamily="Segoe UI" FontSize="12" LineHeight="18" Margin="1,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#CFE5D6" CornerRadius="11" Padding="10,10" Margin="-3,22,-3,0">
          <StackPanel Orientation="Horizontal"><Path Data="M 2,4 L 18,4 M 2,10 L 18,10 M 2,16 L 12,16" Stroke="#28684F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" VerticalAlignment="Center"/><TextBlock Text="应用连接" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Border>
        <StackPanel Grid.Row="3">
          <TextBlock x:Name="RailCaption" Text="看见连接，也看清边界。" Foreground="#526E5C" FontSize="11" Margin="0,0,0,10"/>
          <Button x:Name="InfoButton" Content="数据说明" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Margin="-8,0,-8,5" FontSize="12" ToolTip="这些数据意味着什么：TCP、UDP 和采集范围"/>
          <Border Height="1" Background="#CFDFD2" Margin="0,0,0,12"/>
          <Button x:Name="TrayButton" Content="收起到托盘" Style="{StaticResource QuietButton}" Margin="-8,0,-8,3" FontSize="12"/>
          <Button x:Name="ExitButton" Content="退出 NetPeek" Style="{StaticResource QuietButton}" Margin="-8,0,-8,0" FontSize="12"/>
          <TextBlock Text="本地运行 · 无自动联网" FontSize="10" Foreground="#526E5C" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="MainPane" Grid.Column="1" Margin="24,20,24,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="HeaderLabels"><TextBlock Text="应用连接" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="HeaderSubtitle" Text="每个应用的网络动向，一眼看清。" Foreground="#5F7168" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <StackPanel x:Name="CompactActions" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Top">
          <Button x:Name="CompactInfoButton" Content="说明" Style="{StaticResource QuietButton}" Padding="8,5" ToolTip="连接数据说明"/>
          <Button x:Name="CompactTrayButton" Content="托盘" Style="{StaticResource QuietButton}" Padding="8,5" ToolTip="收起到托盘" Margin="4,0,0,0"/>
          <Button x:Name="CompactExitButton" Content="退出" Style="{StaticResource QuietButton}" Padding="8,5" ToolTip="退出 NetPeek" Margin="4,0,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#E6F1EA" CornerRadius="11" Padding="11,8" VerticalAlignment="Top" Margin="14,5,0,0">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#397A58" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="正在读取连接" FontSize="11" Foreground="#355C44"/></StackPanel>
        </Border>
      </Grid>
      <Border x:Name="SummaryPanel" Grid.Row="1" BorderBrush="#DFE8E1" BorderThickness="0,0,0,1" Margin="0,16,0,14" Padding="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="全机 · 已建立 TCP" Foreground="#5F7168" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="TcpCount" Text="—" FontSize="28" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text=" 条" VerticalAlignment="Bottom" Foreground="#5F7168" FontSize="11" Margin="6,0,0,5"/></StackPanel></StackPanel>
          <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="全机 · TCP 监听" Foreground="#5F7168" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="ListenCount" Text="—" FontSize="28" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text=" 个" VerticalAlignment="Bottom" Foreground="#5F7168" FontSize="11" Margin="6,0,0,5"/></StackPanel></StackPanel>
          <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="全机 · UDP 端点" Foreground="#5F7168" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="UdpCount" Text="—" FontSize="28" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text=" 个" VerticalAlignment="Bottom" Foreground="#5F7168" FontSize="11" Margin="6,0,0,5"/></StackPanel></StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="SearchToolbar" Grid.Row="2" Margin="0,0,0,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SearchColumn" Width="*"/><ColumnDefinition x:Name="StateColumn" Width="132"/><ColumnDefinition x:Name="TimeColumn" Width="140"/><ColumnDefinition x:Name="PauseColumn" Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="SearchBorder" Background="White" BorderBrush="#D5E1D8" BorderThickness="1" CornerRadius="10" Padding="10,0,4,0" Height="38">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Data="M 15,15 L 20,20 M 16,9 A 7,7 0 1 1 2,9 A 7,7 0 1 1 16,9" Stroke="#6D8273" StrokeThickness="1.7" Width="20" Height="22" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#20382E" CaretBrush="#25664F" SelectionBrush="#BBDEC8" VerticalContentAlignment="Center" Padding="5,0" AutomationProperties.Name="搜索应用、PID 或地址" AutomationProperties.HelpText="pid:1234 精确匹配进程；port:443 精确匹配本地或远端端口" ToolTip="搜索应用、IP 或协议；pid:1234 精确查进程，port:443 精确查本地或远端端口 · Enter 定位首个结果 · Ctrl+F"/>
            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索应用、PID 或地址" Foreground="#64766B" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource QuietButton}" Padding="6,2" MinWidth="30" Visibility="Collapsed" ToolTip="清空搜索并恢复全部应用" AutomationProperties.Name="清空搜索"><Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="#486650" StrokeThickness="1.6" Width="12" Height="12"/></Button>
          </Grid>
        </Border>
        <ComboBox x:Name="FilterBox" Grid.Column="1" SelectedIndex="0" Margin="8,0,0,0" Padding="9,8" MinHeight="38" VerticalContentAlignment="Center" Background="White" BorderBrush="#D5E1D8" FontSize="12" AutomationProperties.Name="端点状态筛选" ToolTip="按端点最后观察到的状态筛选；只看当前连接请选择“当前快照”">
          <ComboBoxItem Content="全部状态"/><ComboBoxItem Content="TCP 已建立"/><ComboBoxItem Content="TCP 监听"/><ComboBoxItem Content="UDP 绑定"/><ComboBoxItem Content="TCP 其他状态"/>
        </ComboBox>
        <ComboBox x:Name="TimeFilterBox" Grid.Column="2" SelectedIndex="0" Margin="8,0,0,0" Padding="9,8" MinHeight="38" FontSize="12" AutomationProperties.Name="端点时间范围" ToolTip="历史指当前快照中已不再出现的端点；暂停时以画面时间为准">
          <ComboBoxItem Content="全部时间范围"/><ComboBoxItem Content="当前快照"/><ComboBoxItem Content="近 60 秒历史"/>
        </ComboBox>
        <Button x:Name="PauseButton" Grid.Column="3" Content="暂停刷新" Margin="8,0,0,0" MinWidth="82" FontSize="12" ToolTip="只暂停界面；后台继续采集 · Ctrl+P"/>
      </Grid>
      <StackPanel Grid.Row="3">
        <Border x:Name="WarningPanel" Background="#FFF2D9" CornerRadius="10" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
          <DockPanel><Button x:Name="RetryButton" Content="立即重试" Style="{StaticResource CopyButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="WarningDetailsButton" Content="详情" Style="{StaticResource CopyButton}" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="查看完整采集提示"/><TextBlock x:Name="WarningText" Foreground="#775219" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
        </Border>
        <Grid Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultText" Text="正在发现应用…" Foreground="#5F7168" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ResultHint" Grid.Column="1" Text="点击应用，展开连接详情" Foreground="#5F7168" FontSize="11" Margin="8,0,0,0"/></Grid>
      </StackPanel>
      <Grid Grid.Row="4">
        <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" Padding="0,0,5,0" AutomationProperties.Name="应用连接列表">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Expander Style="{StaticResource AppExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Header="{Binding}" HeaderTemplate="{StaticResource AppHeader}">
              <StackPanel>
                <Border Background="#F4F7F3" CornerRadius="8" Padding="10,7" Margin="0,0,0,9"><DockPanel><Button Content="复制路径" Tag="CopyPath" Style="{StaticResource CopyButton}" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Text="{Binding PathText, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#5F7168" FontSize="11" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Auto" ToolTip="{Binding PathText}" AutomationProperties.Name="应用完整路径"/></DockPanel></Border>
                <DockPanel Margin="4,0,4,5"><Button Content="查看该应用全部端点" Tag="ShowAppEndpoints" Style="{StaticResource CopyButton}" DockPanel.Dock="Right" Visibility="{Binding CanShowAll, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding MatchSummary}" FontSize="11" Foreground="#5F7168" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
                <ItemsControl ItemsSource="{Binding DisplayProcesses}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,3,0,3" HorizontalContentAlignment="Stretch">
                    <Expander.Header><StackPanel Margin="4,3,0,3"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayCountText}" FontSize="11" Foreground="#5F7168" Margin="0,3,0,0"/></StackPanel></Expander.Header>
                    <StackPanel Margin="0,8,0,8">
                      <TextBlock Text="{Binding Note}" Foreground="#5F7168" FontSize="10" Margin="8,0,0,8" TextWrapping="Wrap"/>
                      <DataGrid ItemsSource="{Binding DisplayEndpoints}" MaxHeight="270" AutomationProperties.Name="进程连接详情">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn Header="端点 IP : 端口" Width="*" MinWidth="155"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Grid ToolTip="{Binding PrimaryHint}" AutomationProperties.Name="{Binding PrimaryHint}">
                              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PrimaryAddress}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding PrimaryPort}" FontFamily="Consolas"/>
                              </Grid>
                              <TextBlock Grid.Row="1" Text="{Binding PrimaryRole}" FontSize="10" Foreground="#5F7168"/>
                            </Grid>
                          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                          <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" MinWidth="90" ElementStyle="{StaticResource StatusText}"/>
                          <DataGridTemplateColumn Header="复制" Width="96" MinWidth="96"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                              <Button Content="复制" Tag="CopyEndpoint" Style="{StaticResource CopyButton}" Padding="4,3" ToolTip="复制远端地址；监听和 UDP 复制本地地址"/>
                              <Button Grid.Column="1" Tag="CopyMenu" Style="{StaticResource CopyButton}" Padding="3" Margin="2,0,0,0" ToolTip="更多复制选项 · 也可右键端点或按 Shift+F10" AutomationProperties.Name="更多复制选项"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#294F3E" StrokeThickness="1.5" Width="8" Height="5"/></Button>
                            </Grid>
                          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                          <DataGridTextColumn Header="协议" Binding="{Binding Transport}" Width="84" MinWidth="84"/>
                          <DataGridTextColumn Header="本地 IP : 端口" Binding="{Binding Local}" Width="*" MinWidth="155" ElementStyle="{StaticResource EndpointText}"/>
                          <DataGridTextColumn Header="地址范围" Binding="{Binding Scope}" Width="78" MinWidth="78"/>
                          <DataGridTextColumn Header="最后出现" Binding="{Binding TimeText}" Width="88" MinWidth="88"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </StackPanel>
                  </Expander>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Expander>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible" Margin="16">
          <Border Width="52" Height="52" Background="#E6F1EA" CornerRadius="17" HorizontalAlignment="Center" Margin="0,0,0,12"><Path x:Name="EmptyGlyph" Data="M 23,23 L 31,31 M 25,15 A 10,10 0 1 1 5,15 A 10,10 0 1 1 25,15" Stroke="#46775B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="EmptyTitle" Text="正在读取本机连接…" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock x:Name="EmptyDescription" Text="首次完整采样后，应用会出现在这里。" Foreground="#5F7168" FontSize="12" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
          <Button x:Name="ResetFiltersButton" Content="清空筛选，显示全部" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="5" Margin="2,9,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Footnote" Text="IPv4 + IPv6 · TCP + UDP · 默认无需管理员权限" Foreground="#617569" FontSize="10" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="LastUpdated" Grid.Column="1" Text="等待首次采样" Foreground="#617569" FontSize="10" Margin="12,0,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
